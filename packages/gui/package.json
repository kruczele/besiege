{
  "name": "gui",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:webclient": "vite build --config vite.web.config.ts --watch",
    "dev:webserver": "tsx watch src/web/server/index.ts",
    "build:webclient": "vite build --config vite.web.config.ts",
    "build:webserver": "tsc -p tsconfig.webserver.json",
    "start:web": "node out/web-server/index.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.34.0",
