    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
