{
  "name": "besiege-ai",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "pnpm --parallel --filter daemon --filter gui dev",
    "dev:daemon": "pnpm --filter daemon dev",
    "dev:gui": "pnpm --filter gui dev",
    "dev:webclient": "pnpm --filter gui dev:webclient",
    "dev:webserver": "pnpm --filter gui dev:webserver",
    "web": "node scripts/web.mjs",
    "daemon:reload": "node scripts/reload-daemon.mjs",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "playwright-core": "^1.62.1"
  }
}
